# ==========================================================
# MIKROTIK SCRIPT: Multi-WAN, Traffic VLAN, & Ping Core/Switches
# ==========================================================

:local baseUrl "https://script.google.com/macros/s/AKfycbx4Yx18S7GJQUU0WpWfIgVoRPxk-yKKe9MM8HmXN3IjLufLMnNQTQXohdIs4-6h5b1izw/exec"

# KONFIGURASI TELEGRAM BOT (Ganti dengan Token & Chat ID Anda)
:local tgToken "8824713458:AAGTVVgl5MJUwTVfokR-_nc3K3ARmTf5Hfg"
:local tgChatId "-5151868916"

# 1. Ambil Parameter System MikroTik
:local devName [/system identity get name]
:local cpuLoad [/system resource get cpu-load]
:local uptime [/system resource get uptime]
:local activeLeases 0

:foreach i in=[/ip dhcp-server lease find where status=bound] do={
    :set activeLeases ($activeLeases + 1)
}

# 2. Kirim Metrics Utama Router
:local mainUrl "$baseUrl?type=mikrotik&device_name=$devName&cpu_load=$cpuLoad&uptime=$uptime&active_leases=$activeLeases"
/tool fetch url=$mainUrl mode=https output=none

# 3. Loop Semua Interface Anggota List WAN (WAN1, WAN2, WAN3, dst.)
:foreach w in=[/interface list member find list=WAN] do={
    :local wanInt [/interface list member get $w interface]
    :local isRunning [/interface get [find name=$wanInt] running]
    :local status "Down"
    :if ($isRunning = true) do={ :set status "UP" }
    
    :local rxWan 0
    :local txWan 0
    /interface monitor-traffic interface=$wanInt once do={
        :set rxWan ($"rx-bits-per-second" / 1000000)
        :set txWan ($"tx-bits-per-second" / 1000000)
    }
    
    :local wanUrl "$baseUrl?type=wan_traffic&wan_name=$wanInt&status=$status&rx_mbps=$rxWan&tx_mbps=$txWan"
    /tool fetch url=$wanUrl mode=https output=none
}

# 4. Loop Semua Interface VLAN untuk Kirim Traffic per-VLAN
:foreach vlan in=[/interface vlan find] do={
    :local vlanName [/interface vlan get $vlan name]
    :local rxVlan 0
    :local txVlan 0
    
    /interface monitor-traffic interface=$vlanName once do={
        :set rxVlan ($"rx-bits-per-second" / 1000000)
        :set txVlan ($"tx-bits-per-second" / 1000000)
    }
    
    :local vlanUrl "$baseUrl?type=vlan_traffic&vlan_name=$vlanName&rx_mbps=$rxVlan&tx_mbps=$txVlan"
    /tool fetch url=$vlanUrl mode=https output=none
}

# 5. PING KELOMPOK CORE DEVICES & SWITCHES (Menggunakan Array Loop)
:local switchUrl "$baseUrl?type=switch_ping"

# Daftar Perangkat (IP | Nama | Model) - Tambahkan di sini jika ada Switch baru
:local ipList {"192.168.16.1"; "10.99.1.5"; "192.168.16.254"}
:local nameList {"CCR2004_Core_Router"; "UniFi_Dream_Machine_Pro"; "AdGuard_Home_DNS"}
:local modelList {"MikroTik_RouterOS"; "UDM_Pro"; "Debian_Server"}

:for i from=0 to=([:len $ipList] - 1) do={
    :local ip [:pick $ipList $i]
    :local devNamePing [:pick $nameList $i]
    :local devModel [:pick $modelList $i]
    :local status "OFFLINE"
    
    :if ([/ping $ip count=2 interval=200ms] > 0) do={ 
        :set status "ONLINE" 
    }
    
    :local pingUrl "$switchUrl&switch_name=$devNamePing&model=$devModel&status=$status"
    /tool fetch url=$pingUrl mode=https output=none

    # Kirim alert ke Telegram HANYA JIKA perangkat berstatus OFFLINE
    :if ($status = "OFFLINE") do={
        :local message "⚠️ *WARNING: Perangkat Offline!*%0A- Nama: $devNamePing%0A- Model: $devModel%0A- IP: $ip%0A- Router: $devName"
        :local tgUrl "https://api.telegram.org/bot$tgToken/sendMessage?chat_id=$tgChatId&text=$message&parse_mode=Markdown"
        /tool fetch url=$tgUrl mode=https output=none
    }
}
